{
  "name": "@eradigm/web",
  "version": "1.0.0",
  "private": true,
  "description": "Client-facing dashboard (React SPA served by a Cloudflare Worker with static assets). Talks only to the API.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "wrangler dev --env dev --port 8788",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@eradigm/shared": "*",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
