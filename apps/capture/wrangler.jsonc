// Isolated capture worker (2_Input_Architecture: "Capture the source in an isolated worker").
//
// Deliberately has NO D1, storage, queue or application-secret bindings: a
// compromised page can never reach the database or credentials. It is not
// publicly routable (workers_dev = false, no routes); only the API reaches it
// through a service binding.
//
// Runs on the Workers Free plan: page parsing uses the native HTMLRewriter so
// a typical article stays within the 10 ms CPU allowance. JavaScript-heavy or
// login-protected pages are handled by uploading a SingleFile HTML instead.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eradigm-ci-capture",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "eradigm-ci-capture-dev",
      "vars": { "CAPTURE_USER_AGENT": "EradigmCI-Capture/1.0 (+https://eradigm.com)", "DNS_RESOLVER_URL": "https://cloudflare-dns.com/dns-query" }
    },
    "staging": {
      "name": "eradigm-ci-capture-staging",
      "vars": { "CAPTURE_USER_AGENT": "EradigmCI-Capture/1.0 (+https://eradigm.com)", "DNS_RESOLVER_URL": "https://cloudflare-dns.com/dns-query" }
    },
    "production": {
      "name": "eradigm-ci-capture-production",
      "vars": { "CAPTURE_USER_AGENT": "EradigmCI-Capture/1.0 (+https://eradigm.com)", "DNS_RESOLVER_URL": "https://cloudflare-dns.com/dns-query" }
    }
  }
}
