# Copy to apps/api/.dev.vars for local development (never commit .dev.vars).
# The prototype uses manual entry (LLM_PROVIDER=none): no API key is needed.
# To try the offline pre-fill heuristics, set LLM_PROVIDER=mock in wrangler.jsonc (dev env).
# To try real LLM pre-fill locally (see docs/ENABLING-AUTOFILL.md), set LLM_PROVIDER=anthropic and:
ANTHROPIC_API_KEY=
# Optional locally:
SNAPSHOT_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
